{
  "name": "somador-de-contas",
  "version": "2.0.0",
  "description": "Soma o valor de boletos em PDF, tudo processado localmente no seu computador. Visual baseado no GNOME HIG.",
  "author": "Victor Ferreira Franco",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.victorferreirafranco.somadordecontas",
    "productName": "Somador de Contas",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "synopsis": "Some o valor de boletos em PDF, localmente"
    },
    "extraResources": [
      {
        "from": "preload.js",
        "to": "preload.js"
      }
    ]
  }
}
