{
  "name": "budget",
  "version": "6.1.1",
  "description": "Soma o valor de boletos em PDF, tudo processado localmente no seu computador. Visual baseado no GNOME HIG.",
  "author": "Victor Ferreira Franco",
  "homepage": "https://github.com/victorffrock/budget",
  "repository": "https://github.com/victorffrock/budget.git",
  "license": "GPL-3.0-or-later",
  "desktopName": "br.com.victorferreirafranco.budget",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:ui": "electron e2e/ui-flow.cjs",
    "dist": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "toolsets": {
      "appimage": "1.0.3"
    },
    "artifactName": "Budget-${version}-x86_64.${ext}",
    "appId": "br.com.victorferreirafranco.budget",
    "productName": "Budget",
    "files": [
      "main.js",
      "gnome-accent.js",
      "menu.js",
      "preload.js",
      "index.html",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "category": "Office",
      "synopsis": "Some o valor de boletos em PDF, localmente"
    },
    "extraResources": [
      {
        "from": "preload.js",
        "to": "preload.js"
      }
    ]
  },
  "allowScripts": {
    "electron@43.4.1": true
  }
}
